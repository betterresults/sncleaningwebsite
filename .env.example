# Server
PORT=3000

# Supabase (content database — services, service pages, blog posts)
# Safe defaults are already baked into lib/supabase.js using the public "anon" key,
# so these are optional overrides, not required for the site to work.
SUPABASE_URL=https://dkomihipebixlegygnoy.supabase.co
SUPABASE_ANON_KEY=

# SMTP settings for the contact form (optional).
# If left unset, form submissions are just logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@sncleaningservices.co.uk
