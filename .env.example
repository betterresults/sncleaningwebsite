# Server
PORT=3000

# Supabase (content database — services, service pages, blog posts)
# Safe defaults are already baked into lib/supabase.js using the public "anon" key,
# so these are optional overrides, not required for the site to work.
SUPABASE_URL=https://dkomihipebixlegygnoy.supabase.co
SUPABASE_ANON_KEY=

# SMTP settings for the contact form (optional).
# If left unset, form submissions are just logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@sncleaningservices.co.uk

# Optional. End of tenancy checklist delivery. Leave unset on Netlify until a
# live send is wanted. The page and the form still return HTTP 200.
# DILVON_DOMESTIC_API_KEY is server-only. Never put it in the repo or the browser.
# DILVON_SEND_ENABLED must be the string true, as well as the key, before any
# Dilvon create or send runs. Sender is SN Cleaning (sender_profile_id
# adda94ca-9849-419c-aecb-fe1d742daa72) from sales@sncleaningservices.co.uk.
# Company id, if a customer is created: 625a39b1-fe35-4f0d-8770-f2b3538023b9.
# DILVON_DOMESTIC_API_URL overrides the gateway if the default function path differs.
# SUPABASE_WEBSITE_SERVICE_KEY (or SUPABASE_SERVICE_ROLE_KEY) writes eot_checklists.
# If it is unset, the form skips the database and still returns 200.
DILVON_DOMESTIC_API_KEY=
DILVON_SEND_ENABLED=false
DILVON_DOMESTIC_API_URL=
SUPABASE_WEBSITE_SERVICE_KEY=
