<%
// Homepage hero. One action only: a postcode and a button. Phone and WhatsApp
// live in the header and footer as persistent contact routes.
//
// The button goes to /book rather than straight to a booking form, because at
// this point we do not know which service the visitor wants - that is what the
// chooser page asks. The postcode travels with them.
%>
<section class="home-hero" style="background-image: url('/images/hero-living-room.jpg?v=<%= assetVersion %>')">
  <div class="container home-hero-inner">
    <p class="hero-kicker">London &amp; Essex</p>
    <h1>Your home deserves a proper clean</h1>
    <p class="home-hero-lead">
      Not a quick tidy &mdash; a clean you actually notice. Our own insured, DBS-checked
      cleaners bring everything with them and work to a checklist, so the only thing left
      for you to do is enjoy it.
    </p>

    <form class="home-quote" action="/book" method="GET" id="home-quote">
      <label for="home-postcode" class="visually-hidden">Your postcode</label>
      <input id="home-postcode" name="postcode" type="text" inputmode="text"
             autocomplete="postal-code" placeholder="Your postcode" aria-describedby="home-quote-msg" />
      <button type="submit" class="btn btn-primary btn-lg">Get a quote</button>
    </form>
    <p class="home-quote-msg" id="home-quote-msg" role="status" hidden></p>
  </div>
</section>

<script>
  // Format-check the postcode before sending anyone on. Whether we cover it is
  // decided on the service page, because coverage differs by service.
  (function () {
    var form = document.getElementById('home-quote');
    var input = document.getElementById('home-postcode');
    var msg = document.getElementById('home-quote-msg');
    if (!form || !input) return;

    var FULL = /^[A-Z]{1,2}[0-9][A-Z0-9]?[0-9][A-Z]{2}$/;
    var OUTWARD = /^[A-Z]{1,2}[0-9][A-Z0-9]?$/;

    form.addEventListener('submit', function (e) {
      var v = String(input.value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
      if (v && !FULL.test(v) && !OUTWARD.test(v)) {
        e.preventDefault();
        if (msg) {
          msg.textContent = 'That does not look like a UK postcode.';
          msg.hidden = false;
        }
        input.focus();
      }
    });
    input.addEventListener('input', function () { if (msg) msg.hidden = true; });
  })();
</script>

<section class="section services-preview">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">What We Do</span>
      <h2>The cleans people book us for</h2>
      <p>Regular homes, move-outs, guest changeovers and the deep cleans in between.</p>
    </div>

    <div class="grid grid-2">
      <% services.forEach(function(service) { %>
        <a href="/<%= service.slug %>" class="card service-card">
          <div class="service-card-photo">
            <img src="<%= serviceImage(service.slug) %>?v=<%= assetVersion %>" alt="<%= service.title %>" />
          </div>
          <div class="service-card-body">
            <h3><%= service.title %></h3>
            <p><%= service.short_description %></p>
            <span class="card-link">What's included</span>
          </div>
        </a>
      <% }); %>
    </div>

    <div class="center-cta">
      <a href="/our-services" class="btn btn-outline">All services</a>
    </div>
  </div>
</section>

<%- include('partials/cleaning-checklist') %>

<section class="section why-us alt-bg">
  <div class="container grid grid-2 align-center">
    <div>
      <span class="eyebrow">Why SN</span>
      <h2>A local team, not a franchise script</h2>
      <ul class="checklist">
        <li><strong>Our cleaners, every job</strong> — we don't send subcontractors into your home.</li>
        <li><strong>Insured and DBS-checked</strong> — trained staff you can leave a key with.</li>
        <li><strong>End of tenancy that stands up to agents</strong> — the checklist landlords actually walk through.</li>
        <li><strong>Re-clean guarantee</strong> — tell us within 24 hours and we'll come back, free.</li>
      </ul>
      <a href="/about" class="btn btn-primary">About the company</a>
    </div>
    <div class="why-us-media">
      <img src="/images/about-cleaner.jpg?v=<%= assetVersion %>" alt="An SN Cleaning Services cleaner" />
      <div class="stat-card-grid stat-card-grid--overlay">
        <div class="stat-card"><strong>10+</strong><span>Years in the area</span></div>
        <div class="stat-card"><strong>London &amp; Essex</strong><span>Where we work</span></div>
        <div class="stat-card"><strong>Own staff</strong><span>No gig workers</span></div>
        <div class="stat-card"><strong>Re-clean</strong><span>If we miss a bit</span></div>
      </div>
    </div>
  </div>
</section>

<% if (typeof coverageAreas !== 'undefined' && coverageAreas.length) { %>
<section class="section coverage">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Coverage</span>
      <h2>London and Essex</h2>
      <p>If you don't see your area, ask — we often can. Recurring weekly, fortnightly and monthly cleans are discounted.</p>
    </div>
    <div class="area-tags">
      <% coverageAreas.forEach(function(area) { %>
        <span class="area-tag"><%= area %></span>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section testimonials alt-bg">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Customers</span>
      <h2>What people tell us</h2>
      <p>A few comments from jobs around London. <% if (site.googleBusinessUrl) { %><a href="<%= site.googleBusinessUrl %>" target="_blank" rel="noopener">Read recent Google reviews</a>.<% } else { %>Ask us for recent Google reviews when you enquire.<% } %></p>
    </div>
    <div class="grid grid-3">
      <% testimonials.forEach(function(t) { %>
        <div class="card testimonial-card">
          <div class="stars"><%= '★'.repeat(t.rating) %></div>
          <p class="quote">"<%= t.quote %>"</p>
          <p class="testimonial-author"><strong><%= t.name %></strong> — <%= t.location %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<% if (typeof faqs !== 'undefined' && faqs.length) { %>
<section class="section faq">
  <div class="container" style="max-width:820px;">
    <div class="section-heading">
      <span class="eyebrow">FAQs</span>
      <h2>Before you book</h2>
    </div>
    <div class="faq-list">
      <% faqs.forEach(function(faq) { %>
        <details class="faq-item">
          <summary><h3><%= faq.question %></h3></summary>
          <p><%= faq.answer %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section cta-band">
  <div class="container cta-band-inner">
    <div>
      <h2>Need a clean in London or Essex?</h2>
      <p>Send the postcode and what you need. We'll quote you — usually the same weekday.</p>
    </div>
    <div class="cta-band-actions">
      <a href="/contact" class="btn btn-primary btn-lg">Request a quote</a>
      <% if (site.whatsappUrl) { %>
        <a href="<%= site.whatsappUrl %>" class="btn btn-outline btn-lg" target="_blank" rel="noopener">WhatsApp</a>
      <% } %>
    </div>
  </div>
</section>
