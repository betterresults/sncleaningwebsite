<section class="page-hero page-hero--photo" style="background-image: url('<%= serviceImage(service.slug) %>')">
  <div class="container">
    <span class="eyebrow"><%= parent ? service.title + ' · ' + parent.name : service.title %></span>
    <h1><%= service.title %> in <%= region.name %></h1>
    <p><%= page.meta_description || `${service.title} in ${region.name}.` %></p>
    <div class="quote-card-badges" style="margin-top:18px;">
      <span>Insured</span>
      <span>DBS-checked</span>
      <span>Own staff</span>
      <span>Re-clean guarantee</span>
    </div>
    <div class="page-hero-actions">
      <a href="/contact" class="btn btn-primary btn-lg">Request a quote</a>
    </div>
  </div>
</section>

<!-- Overview -->
<% if (page.intro) { %>
<section class="section">
  <div class="container" style="max-width:820px;">
    <p><%= page.intro %></p>
  </div>
</section>
<% } %>

<!-- Why choose us -->
<section class="section alt-bg">
  <div class="container grid grid-2 align-center">
    <div>
      <span class="eyebrow">Why SN</span>
      <h2>A local team, not a franchise script</h2>
      <ul class="checklist">
        <li><strong>Our cleaners, every job</strong> — we don't send subcontractors into your home.</li>
        <li><strong>Insured and DBS-checked</strong> — trained staff you can leave a key with.</li>
        <li><strong>Re-clean guarantee</strong> — tell us within 24 hours and we'll come back, free.</li>
        <li><strong>We bring the supplies</strong> — including eco-friendly products on request.</li>
      </ul>
      <a href="/about" class="btn btn-primary">About the company</a>
    </div>
    <div class="stat-card-grid">
      <div class="stat-card"><strong>12</strong><span>Years in business</span></div>
      <div class="stat-card"><strong>London &amp; Essex</strong><span>Where we work</span></div>
      <div class="stat-card"><strong>Own staff</strong><span>No gig workers</span></div>
      <div class="stat-card"><strong>Re-clean</strong><span>If we miss a bit</span></div>
    </div>
  </div>
</section>

<!-- Other services available here -->
<% var otherServices = (typeof services !== 'undefined' ? services : []).filter(function(s) { return s.slug !== service.slug; }); %>
<% if (otherServices.length) { %>
<section class="section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Also Available in <%= region.name %></span>
      <h2>Other cleaning services we offer here</h2>
    </div>
    <div class="grid grid-3">
      <% otherServices.forEach(function(s) { %>
        <a href="/<%= s.slug %>" class="card service-card">
          <div class="service-card-photo">
            <img src="<%= serviceImage(s.slug) %>?v=<%= assetVersion %>" alt="<%= s.title %>" />
          </div>
          <div class="service-card-body">
            <h3><%= s.title %></h3>
            <p><%= s.short_description %></p>
            <span class="card-link">What's included</span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Related areas -->
<% if (typeof relatedAreas !== 'undefined' && relatedAreas.length) { %>
<section class="section alt-bg">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Nearby</span>
      <h2><%= service.title %> near <%= region.name %></h2>
    </div>
    <div class="area-tags">
      <% relatedAreas.forEach(function(a) { %>
        <a href="<%= a.url %>" class="area-tag"><%= a.name %></a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Full coverage -->
<% if (typeof coverageAreas !== 'undefined' && coverageAreas.length) { %>
<section class="section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Coverage</span>
      <h2>All the areas we cover</h2>
      <p>We cover the boroughs and towns below — if you don't see yours listed, get in touch and we'll confirm availability.</p>
    </div>
    <div class="area-tags">
      <% coverageAreas.forEach(function(area) { %>
        <span class="area-tag"><%= area %></span>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Testimonials -->
<% if (typeof testimonials !== 'undefined' && testimonials.length) { %>
<section class="section alt-bg testimonials">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">Testimonials</span>
      <h2>What our customers say</h2>
    </div>
    <div class="grid grid-3">
      <% testimonials.forEach(function(t) { %>
        <div class="card testimonial-card">
          <div class="testimonial-top">
            <div class="stars"><%= '★'.repeat(t.rating) %></div>
          </div>
          <p class="quote">"<%= t.quote %>"</p>
          <p class="testimonial-author"><strong><%= t.name %></strong> — <%= t.location %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- FAQs -->
<% if (page.faqs && page.faqs.length) { %>
<section class="section faq">
  <div class="container" style="max-width:820px;">
    <div class="section-heading">
      <span class="eyebrow">FAQs</span>
      <h2>Frequently Asked Questions</h2>
    </div>
    <div class="faq-list">
      <% page.faqs.forEach(function(faq) { %>
        <div class="faq-item">
          <h3><%= faq.question %></h3>
          <p><%= faq.answer %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section cta-band">
  <div class="container cta-band-inner">
    <div>
      <h2>Ready to book <%= service.title.toLowerCase() %> in <%= region.name %>?</h2>
      <p>Tell us the postcode and we'll come back with a quote.</p>
    </div>
    <a href="/contact" class="btn btn-primary btn-lg">Request a quote</a>
  </div>
</section>
