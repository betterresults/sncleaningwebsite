<%
// Per-service, per-area landing page — e.g. /end-of-tenancy-cleaning/romford/.
//
// Sections, in order:
//   1. Hero        — full-bleed photo under a dark scrim, headline, review
//                    badge, and the instant-quote calculator on the right.
//   2. Intro       — local copy beside a photograph.
//   3. Promise     — the deposit-back guarantee.
//   4. Pricing     — "from" prices by bedroom count.
//   5. Included    — room photography plus the full checklist.
//   6. Add-ons     — oven and carpet, on a light tinted band.
//   7. Steps       — how a booking runs.
//   8. Content     — long-form local sections from content_sections.
//   9. Manager     — a real named local person, when the row has one.
//  10. Reviews
//  11. Questions   — the page's only FAQ block, with the assistant beside it.
//  12. Areas       — postcodes, neighbourhoods, nearby area pages.
//  13. Services    — other work we do here.
//  14. Closing CTA
//
// Blocks hide themselves when their column is empty, so a sparse row renders
// short rather than padded out with filler.
//
// coverage_regions.name is an internal ops label ("Essex - Romford / Thurrock
// Edge"); display_name is the customer-facing place name ("Romford").
const areaName = region.display_name || region.name;
const parentName = parent ? (parent.display_name || parent.name) : null;
const serviceName = service.title;
const tiers = (page.pricing_tiers && page.pricing_tiers.length) ? page.pricing_tiers : [];
const addOns = (page.add_ons && page.add_ons.length) ? page.add_ons : [];
const postcodes = (page.postcodes && page.postcodes.length) ? page.postcodes : [];
const hoods = (page.neighbourhoods && page.neighbourhoods.length) ? page.neighbourhoods : [];
const rooms = (page.included_tasks && page.included_tasks.length)
  ? page.included_tasks
  : (typeof serviceIncludedTasks !== 'undefined' ? serviceIncludedTasks : []);
const priceFrom = page.price_from || (tiers.length ? Math.min.apply(null, tiers.map(t => t.price)) : null);
const quoteHref = `/contact?area=${encodeURIComponent(areaName)}&service=${service.slug}`;
const allTasks = rooms.reduce(function (acc, r) { return acc.concat(r.tasks || []); }, []);
const extraBathroom = page.extra_bathroom_price || 25;
// Tiers the calculator can price from — only those tagged with a bedroom count.
const calcTiers = tiers.filter(function (t) { return typeof t.beds === 'number'; });
const roomShots = [
  { src: '/images/rooms/kitchen.jpg', label: 'Kitchens' },
  { src: '/images/rooms/bathroom.jpg', label: 'Bathrooms' },
  { src: '/images/rooms/room.jpg', label: 'Bedrooms' },
  { src: '/images/rooms/hallway.jpg', label: 'Halls and stairs' }
];
%>

<!-- 1 · Hero ============================================================= -->
<section class="hero-area" style="background-image: url('<%= serviceImage(service.slug) %>?v=<%= assetVersion %>')">
  <div class="container hero-area-grid">

    <div class="hero-area-copy">
      <p class="hero-kicker"><%= parentName ? parentName : 'London &amp; Essex' %></p>
      <h1><%= serviceName %> in <%= areaName %></h1>
      <p class="hero-lead-text"><%= page.meta_description || `${serviceName} in ${areaName}, carried out by our own insured, DBS-checked staff.` %></p>

      <% if (page.rating) { %>
        <% var ratingHref = page.review_url || null; %>
        <<%= ratingHref ? 'a' : 'div' %> class="gbadge"<% if (ratingHref) { %> href="<%= ratingHref %>" target="_blank" rel="noopener"<% } %>>
          <span class="gbadge-mark" aria-hidden="true">G</span>
          <span class="gbadge-body">
            <span class="gbadge-score"><%= page.rating %> <span class="stars"><%= '★'.repeat(Math.round(page.rating)) %></span></span>
            <span class="gbadge-sub">Rated on Google</span>
          </span>
        </<%= ratingHref ? 'a' : 'div' %>>
      <% } %>
    </div>

    <!-- Instant quote calculator. Prices from the same tiers the pricing
         section shows, so the two can never disagree. -->
    <form class="quoter" action="/contact" method="GET" id="quoter">
      <input type="hidden" name="service" value="<%= service.slug %>" />
      <input type="hidden" name="area" value="<%= areaName %>" />

      <p class="quoter-head">Get an instant quote</p>

      <label for="q-beds">Bedrooms</label>
      <select id="q-beds" name="bedrooms">
        <% calcTiers.forEach(function(t, i) { %>
          <option value="<%= t.beds %>"<%= i === 1 ? ' selected' : '' %>><%= t.property %></option>
        <% }); %>
      </select>

      <label for="q-baths">Bathrooms</label>
      <select id="q-baths" name="bathrooms">
        <% [1,2,3,4].forEach(function(n) { %>
          <option value="<%= n %>"><%= n %><%= n === 4 ? '+' : '' %></option>
        <% }); %>
      </select>

      <label for="q-postcode">Postcode</label>
      <input id="q-postcode" name="postcode" type="text" inputmode="text" autocomplete="postal-code"
             placeholder="<%= postcodes.length ? postcodes[0] + ' 1AA' : 'e.g. RM1 1AA' %>" />

      <% if (calcTiers.length) { %>
        <output class="quoter-out" for="q-beds q-baths" id="q-out">
          <span class="quoter-out-label">Estimated price</span>
          <span class="quoter-out-price" id="q-price">&pound;<%= priceFrom %></span>
        </output>
      <% } %>

      <button type="submit" class="btn btn-primary btn-block">Get instant quote</button>
      <p class="quoter-note">A guide price for an empty property. We confirm the fixed price by email, usually the same working day.</p>
    </form>

  </div>
</section>

<% if (calcTiers.length) { %>
<script>
  // Live estimate in the hero calculator. Progressive enhancement: with JS off
  // the form still submits to /contact with the same fields.
  (function () {
    var tiers = <%- JSON.stringify(calcTiers.map(function (t) { return { beds: t.beds, price: t.price }; })) %>;
    var extraBath = <%= extraBathroom %>;
    var beds = document.getElementById('q-beds');
    var baths = document.getElementById('q-baths');
    var out = document.getElementById('q-price');
    if (!beds || !baths || !out) return;

    function update() {
      var b = Number(beds.value);
      var match = tiers.filter(function (t) { return t.beds <= b; }).pop() || tiers[0];
      var total = match.price + (Number(baths.value) - 1) * extraBath;
      out.textContent = '£' + total;
    }
    beds.addEventListener('change', update);
    baths.addEventListener('change', update);
    update();
  })();
</script>
<% } %>

<!-- 2 · Local intro ====================================================== -->
<% if (page.local_intro || page.intro) { %>
<section class="band">
  <div class="container split">
    <div>
      <p class="eyebrow"><%= serviceName %> &middot; <%= areaName %></p>
      <h2><%= serviceName %> across <%= areaName %></h2>
      <% if (page.local_intro) { %><p><%= page.local_intro %></p><% } %>
      <% if (page.intro) { %><p><%= page.intro %></p><% } %>
    </div>
    <img class="split-photo" src="/images/about-cleaner.jpg?v=<%= assetVersion %>"
         alt="An SN Cleaning team member at work in <%= areaName %>" loading="lazy" />
  </div>
</section>
<% } %>

<!-- 3 · Promise ========================================================== -->
<section class="band band--tint">
  <div class="container narrow center">
    <h2>Cleaned to a deposit-ready standard</h2>
    <p>
      We clean against the same written schedule inventory clerks inspect from. If anything
      cleaning-related is flagged within 72 hours of your check-out, we come back and put it right
      free of charge.
    </p>
  </div>
</section>

<!-- 4 · Pricing ========================================================== -->
<% if (tiers.length) { %>
<section class="band">
  <div class="container narrow">
    <p class="eyebrow">Pricing</p>
    <h2><%= serviceName %> prices in <%= areaName %></h2>
    <p><%= page.quick_answer || '' %></p>
    <ul class="price-rows">
      <% tiers.forEach(function(t) { %>
        <li>
          <span class="price-label"><%= t.property %></span>
          <span class="price-value">from &pound;<%= t.price %></span>
        </li>
      <% }); %>
    </ul>
    <p class="fineprint">
      Guide prices for an empty property with one bathroom. Extra bathrooms are &pound;<%= extraBathroom %> each.
      A place left in heavy condition is quoted individually — we will always tell you before the day
      rather than after it.
    </p>
  </div>
</section>
<% } %>

<!-- 5 · What's included ================================================== -->
<% if (allTasks.length) { %>
<section class="band band--alt">
  <div class="container">
    <div class="band-head">
      <p class="eyebrow">What's included</p>
      <h2>A full inspection-standard clean</h2>
      <p>Every <%= areaName %> job covers the same scope, top to bottom. Nothing on this list is held back as an optional extra.</p>
    </div>

    <div class="shots">
      <% roomShots.forEach(function(s) { %>
        <figure>
          <img src="<%= s.src %>?v=<%= assetVersion %>" alt="<%= s.label %> cleaned to inspection standard" loading="lazy" width="1280" height="720" />
          <figcaption><%= s.label %></figcaption>
        </figure>
      <% }); %>
    </div>

    <ul class="tick-list">
      <% allTasks.forEach(function(task) { %><li><%= task %></li><% }); %>
    </ul>
  </div>
</section>
<% } %>

<!-- 6 · Add-ons ========================================================== -->
<% if (addOns.length) { %>
<section class="extras">
  <div class="container extras-grid">
    <div>
      <p class="eyebrow">Optional extras</p>
      <h2>Add oven or carpet cleaning to your clean</h2>
      <p>Booked alongside the main clean, so it is one visit, one team and one invoice.</p>
    </div>
    <ul class="extras-list">
      <% addOns.forEach(function(a) { %>
        <li>
          <strong><%= a.name %></strong>
          <span><% if (a.price) { %>&pound;<%= a.price %><% if (a.note) { %> <%= a.note %><% } %><% } else { %>On quote<% } %></span>
        </li>
      <% }); %>
    </ul>
  </div>
</section>
<% } %>

<!-- 7 · Steps ============================================================ -->
<section class="band">
  <div class="container">
    <div class="band-head">
      <p class="eyebrow">How it works</p>
      <h2>Booked in three simple steps</h2>
    </div>
    <ol class="steps-row">
      <li>
        <span class="step-num">1</span>
        <h3>Tell us about the property</h3>
        <p>Bedrooms, bathrooms and your check-out date. A minute, and a few photos if anything needs flagging.</p>
      </li>
      <li>
        <span class="step-num">2</span>
        <h3>Get a fixed quote</h3>
        <p>A firm price, not an hourly estimate, usually back the same working day.</p>
      </li>
      <li>
        <span class="step-num">3</span>
        <h3>We clean and document</h3>
        <p>Our team works the full checklist, then sends photos once the property is finished.</p>
      </li>
    </ol>
  </div>
</section>

<!-- 7b · Long-form local content. Each entry is its own section, so an area
         can carry as much genuine local detail as it has. ================== -->
<% if (page.content_sections && page.content_sections.length) { %>
<% page.content_sections.forEach(function(block, i) { %>
<section class="band<%= i % 2 === 1 ? ' band--alt' : '' %>">
  <div class="container narrow">
    <h2><%= block.heading %></h2>
    <% (block.body || []).forEach(function(para) { %><p><%= para %></p><% }); %>
  </div>
</section>
<% }); %>
<% } %>

<!-- 8 · Local manager. Renders only with a real person on the row. ======== -->
<% if (page.manager_name && page.manager_note) { %>
<section class="band band--alt">
  <div class="container manager-grid">
    <% if (page.manager_photo) { %>
      <img class="manager-photo" src="<%= page.manager_photo %>" alt="<%= page.manager_name %>, <%= page.manager_role || 'area manager' %> for <%= areaName %>" loading="lazy" />
    <% } %>
    <div>
      <p class="eyebrow">Your local team</p>
      <h2>Hi, I'm <%= page.manager_name %></h2>
      <% if (page.manager_role) { %><p class="manager-role"><%= page.manager_role %></p><% } %>
      <p><%= page.manager_note %></p>
    </div>
  </div>
</section>
<% } %>

<!-- 9 · Reviews ========================================================== -->
<% if (typeof testimonials !== 'undefined' && testimonials.length) { %>
<section class="band">
  <div class="container">
    <div class="band-head">
      <p class="eyebrow">Reviews</p>
      <h2>What customers say</h2>
    </div>
    <div class="review-row">
      <% testimonials.forEach(function(t) { %>
        <blockquote class="review">
          <span class="stars"><%= '★'.repeat(t.rating) %></span>
          <p><%= t.quote %></p>
          <cite><%= t.name %><% if (t.location) { %> &middot; <%= t.location %><% } %></cite>
        </blockquote>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- 10 · Questions — the page's only FAQ block, with the assistant beside it -->
<% if (page.faqs && page.faqs.length) { %>
<section class="band band--alt" id="faq">
  <div class="container faq-grid">
    <div>
      <p class="eyebrow">FAQ</p>
      <h2><%= serviceName %> questions</h2>
      <div class="faq-list">
        <% page.faqs.forEach(function(faq, i) { %>
          <details class="faq-item" id="faq-<%= i %>">
            <summary><h3><%= faq.question %></h3></summary>
            <p><%= faq.answer %></p>
          </details>
        <% }); %>
      </div>
    </div>

    <aside class="ask">
      <span class="ask-mark" aria-hidden="true">✦</span>
      <h3>Still have a question?</h3>
      <p>Ask our assistant about anything not covered here — what is included, how long your property will take, or whether we can fit your check-out date.</p>
      <a href="<%= quoteHref %>" class="btn btn-primary btn-block">Ask a question</a>
      <p class="ask-note">Answers come back by email while the live assistant is being set up.</p>
    </aside>
  </div>
</section>
<% } %>

<!-- 11 · Areas =========================================================== -->
<% if (postcodes.length || hoods.length || (typeof relatedAreas !== 'undefined' && relatedAreas.length)) { %>
<section class="band areas">
  <div class="container">
    <div class="areas-top">
      <div class="areas-intro">
        <p class="eyebrow">Areas we cover</p>
        <h2>One team across <%= areaName %></h2>
        <p>Same crew, same checklist, same guarantee wherever you are in the area.</p>
      </div>
      <% if (postcodes.length) { %>
        <div class="areas-codes">
          <p class="areas-codes-label">Postcodes</p>
          <ul><% postcodes.forEach(function(pc) { %><li><%= pc %></li><% }); %></ul>
        </div>
      <% } %>
    </div>

    <% if (hoods.length) { %>
      <h3 class="areas-subhead">Neighbourhoods we cover</h3>
      <ul class="hood-list"><% hoods.forEach(function(h) { %><li><%= h %></li><% }); %></ul>
    <% } %>

    <% if (typeof relatedAreas !== 'undefined' && relatedAreas.length) { %>
      <h3 class="areas-subhead">Nearby areas</h3>
      <ul class="area-cards">
        <% relatedAreas.forEach(function(a) { %>
          <li><a href="<%= a.url %>"><span><%= a.name %></span><em aria-hidden="true">&rarr;</em></a></li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</section>
<% } %>

<!-- 12 · Other services ================================================== -->
<% var otherServices = (typeof services !== 'undefined' ? services : []).filter(function(s) { return s.slug !== service.slug; }); %>
<% if (otherServices.length) { %>
<section class="band band--alt">
  <div class="container">
    <div class="band-head">
      <p class="eyebrow">Also in <%= areaName %></p>
      <h2>Other cleaning we do here</h2>
    </div>
    <div class="tiles">
      <% otherServices.forEach(function(s) { %>
        <a class="tile" href="/<%= s.slug %>">
          <span class="tile-photo"><img src="<%= serviceImage(s.slug) %>?v=<%= assetVersion %>" alt="<%= s.title %> in <%= areaName %>" loading="lazy" width="1280" height="720" /></span>
          <span class="tile-body">
            <span class="tile-title"><%= s.title %></span>
            <span class="tile-desc"><%= s.short_description %></span>
            <span class="tile-cta">Find out more</span>
          </span>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- 13 · Closing ========================================================= -->
<section class="closing">
  <div class="container narrow center">
    <h2>Your price for <%= areaName %>, in about a minute</h2>
    <p>Tell us the postcode and your check-out date. We come back with a fixed price, usually the same working day.</p>
    <a href="<%= quoteHref %>" class="btn btn-primary btn-lg">Get a quote</a>
  </div>
</section>
