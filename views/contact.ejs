<section class="page-hero page-hero--plain">
  <div class="container">
    <span class="eyebrow">Contact</span>
    <h1>Tell us about the property</h1>
    <p>We'll send a quote — usually the same weekday. Or call / WhatsApp if that's easier.</p>
  </div>
</section>

<section class="section">
  <div class="container grid grid-2 contact-grid">
    <div class="contact-form-wrap">
      <iframe id="booking-form-contact-us-1790515395831"
        src="https://app.dilvon.com/book/sn-cleaning-services/contact-us-1790515395831?embedded=true"
        style="width:100%;border:0;min-height:600px;display:block;" loading="lazy" title="Contact Us"></iframe>
      <script>
        (function () {
          var formOrigin = new URL("https://app.dilvon.com/book/sn-cleaning-services/contact-us-1790515395831?embedded=true").origin;
          var f = document.getElementById('booking-form-contact-us-1790515395831');
          if (f) { var src = new URL(f.getAttribute('src')); src.searchParams.set('embed_origin', window.location.origin); f.setAttribute('src', src.toString()); }
          window.addEventListener('message', function (e) {
            if (e.origin !== formOrigin) return; if (!e.data) return;
            if (e.data.type === 'lovable-form-resize') { if (f && typeof e.data.height === 'number') { f.style.height = e.data.height + 'px'; } }
            if (e.data.type === 'lovable-form-redirect' && typeof e.data.url === 'string') {
              try { var target = new URL(e.data.url, window.location.href);
                if (target.origin !== window.location.origin && target.origin !== formOrigin) return;
                window.location.href = target.toString(); } catch (_) {}
            }
          });
        })();
      </script>
    </div>

    <div class="contact-info">
      <div class="contact-photo">
        <img src="/images/about-cleaner.jpg?v=<%= assetVersion %>"<%- rs('/images/about-cleaner.jpg', '(max-width: 900px) 100vw, 520px') %> alt="Speak with SN Cleaning Services" width="1152" height="864" decoding="async" />
      </div>
      <div class="contact-info-card">
        <h2 class="h3">Reach us</h2>
        <ul>
          <li><a href="tel:<%= site.phone.replace(/\s+/g, '') %>"><%= site.phone %></a></li>
          <% if (site.whatsappUrl) { %>
            <li><a href="<%= site.whatsappUrl %>" target="_blank" rel="noopener">WhatsApp</a></li>
          <% } %>
          <li><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
          <li><%= site.address %></li>
          <li><%= site.hours %></li>
        </ul>
      </div>
      <div class="contact-info-card">
        <h2 class="h3">Prefer to talk it through?</h2>
        <p>Call or WhatsApp with the postcode and what you need. No obligation.</p>
        <div class="contact-info-actions">
          <a href="tel:<%= site.phone.replace(/\s+/g, '') %>" class="btn btn-outline">Call</a>
          <% if (site.whatsappUrl) { %>
            <a href="<%= site.whatsappUrl %>" class="btn btn-primary" target="_blank" rel="noopener">WhatsApp</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
