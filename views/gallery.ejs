<section class="page-hero page-hero--photo page-hero--gallery">
  <div class="container">
    <span class="eyebrow">Gallery</span>
    <h1>The finish we work to</h1>
    <p>Supporting interiors for now. Before-and-after photos from our actual jobs will replace these.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-3 gallery-grid">
      <% gallery.forEach(function(item) { %>
        <figure class="gallery-item">
          <img src="<%= item.src %>?v=<%= assetVersion %>" alt="<%= item.caption %>" />
          <figcaption><%= item.caption %></figcaption>
        </figure>
      <% }); %>
    </div>
    <p class="gallery-note">
      These are not photos of SN jobs yet. If you have a property like one of these,
      <a href="/contact">ask for a quote</a> and we can talk through similar work.
    </p>
  </div>
</section>

<section class="section cta-band">
  <div class="container cta-band-inner">
    <div>
      <h2>Want this standard in your place?</h2>
      <p>Send the postcode and the type of clean.</p>
    </div>
    <a href="/contact" class="btn btn-primary btn-lg">Request a quote</a>
  </div>
</section>
