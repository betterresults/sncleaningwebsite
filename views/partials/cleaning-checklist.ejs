<section class="section checklist-section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">The Details</span>
      <h2>What Cleaning Consists Of</h2>
      <p>A closer look at what's included, room by room, on every standard clean.</p>
    </div>

    <div class="checklist-tabs" role="tablist">
      <% checklist.forEach(function(cat, i) { %>
        <button
          type="button"
          class="checklist-tab <%= i === 0 ? 'active' : '' %>"
          data-target="<%= cat.key %>"
        ><%= cat.label %></button>
      <% }); %>
    </div>

    <% checklist.forEach(function(cat, i) { %>
      <div class="checklist-panel-wrap <%= i === 0 ? '' : 'hidden' %>" data-panel="<%= cat.key %>">
        <div class="checklist-panel checklist-panel--<%= cat.key %>">
          <div class="checklist-panel-icon"><%= cat.icon %></div>
          <% cat.points.forEach(function(p) { %>
            <div class="checklist-point" style="top: <%= p.top %>; left: <%= p.left %>;">
              <span class="checklist-dot"></span>
              <span class="checklist-label"><%= p.text %></span>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
</section>
