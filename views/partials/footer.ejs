<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <a href="/" class="logo">
        <img src="/images/logo-mark.png?v=<%= assetVersion %>" alt="" class="logo-img logo-img--footer" width="36" height="36" style="background:#fff;padding:3px;border-radius:8px;box-sizing:border-box;" />
        <span class="logo-text"><%= site.name %></span>
      </a>
      <p class="footer-tagline">Domestic, end of tenancy and deep cleaning across London and Essex. 12 years in business, our own insured staff.</p>
      <% if (site.social.facebook || site.social.instagram) { %>
        <div class="footer-social">
          <% if (site.social.facebook) { %>
            <a href="<%= site.social.facebook %>" aria-label="Facebook" target="_blank" rel="noopener">Facebook</a>
          <% } %>
          <% if (site.social.instagram) { %>
            <a href="<%= site.social.instagram %>" aria-label="Instagram" target="_blank" rel="noopener">Instagram</a>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/our-services">Services</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Services</h4>
      <ul>
        <li><a href="/domestic-cleaning">Domestic Cleaning</a></li>
        <li><a href="/end-of-tenancy-cleaning">End of Tenancy</a></li>
        <li><a href="/airbnb-cleaning">Airbnb Cleaning</a></li>
        <li><a href="/deep-house-cleaning">Deep Cleaning</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Get in Touch</h4>
      <ul class="footer-contact">
        <li><a href="tel:<%= site.phone.replace(/\s+/g, '') %>"><%= site.phone %></a></li>
        <% if (site.whatsappUrl) { %>
          <li><a href="<%= site.whatsappUrl %>" target="_blank" rel="noopener">WhatsApp</a></li>
        <% } %>
        <li><a href="mailto:<%= site.email %>"><%= site.email %></a></li>
        <li><%= site.address %></li>
        <li><%= site.hours %></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> <%= site.name %>. All rights reserved.</p>
    </div>
  </div>
</footer>
