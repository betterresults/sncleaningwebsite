<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="logo">
        <% const customLogo = site.logoUrl && /^https?:\/\//.test(site.logoUrl); %>
        <% if (customLogo) { %>
          <img src="<%= site.logoUrl %>" alt="<%= site.name %>" class="logo-img logo-img--full" />
        <% } else { %>
          <img src="/images/logo-mark.png?v=<%= assetVersion %>" alt="" class="logo-img" width="42" height="42" />
          <span class="logo-text"><%= site.name %></span>
        <% } %>
      </a>
    </div>

    <nav class="main-nav" id="main-nav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>

      <div class="nav-dropdown">
        <a href="/our-services" class="<%= currentPath.startsWith('/our-services') ? 'active' : '' %>">
          Services <span class="nav-dropdown-caret">▾</span>
        </a>
        <% if (typeof navServices !== 'undefined' && navServices.length) { %>
          <div class="nav-dropdown-menu">
            <% navServices.forEach(function(s) { %>
              <a href="<%= s.hasDetailPage ? '/' + s.slug : '/our-services#' + s.slug %>">
                <%= s.title %>
              </a>
            <% }); %>
            <a href="<%= commercialUrl %>" target="_blank" rel="noopener">Commercial Cleaning <span aria-hidden="true">↗</span></a>
          </div>
        <% } %>
      </div>

      <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a>
      <a href="/gallery" class="<%= currentPath === '/gallery' ? 'active' : '' %>">Gallery</a>
      <a href="/blog" class="<%= currentPath.startsWith('/blog') ? 'active' : '' %>">Blog</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>

      <div class="nav-mobile-actions">
        <a href="/book" class="btn btn-primary">Get a quote</a>
        <a href="tel:<%= site.phone.replace(/\s+/g, '') %>" class="nav-mobile-link"><span class="hdr-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h2.6l1.4 4.2-2 1.3a11 11 0 0 0 6.4 6.4l1.3-2 4.2 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/></svg></span>Call <%= site.phone %></a>
      </div>
    </nav>

    <div class="header-actions">
      <a href="tel:<%= site.phone.replace(/\s+/g, '') %>" class="hdr-call" aria-label="Call us on <%= site.phone %>">
        <span class="hdr-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h2.6l1.4 4.2-2 1.3a11 11 0 0 0 6.4 6.4l1.3-2 4.2 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/></svg></span>
        <span class="hdr-call-text"><small>Call us</small><%= site.phone %></span>
      </a>
      <% if (site.whatsappUrl) { %>
      <a href="<%= site.whatsappUrl %>" class="hdr-wa" target="_blank" rel="noopener" aria-label="Message us on WhatsApp">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7c-2 0-4-.5-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.2c-.2.2-.4.3-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7c0 1.6 1.2 3.1 1.3 3.3.2.2 2.3 3.5 5.5 4.9 2 .9 2.8.9 3.8.8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.5Z"/></svg><span class="hdr-wa-text">WhatsApp</span>
      </a>
      <% } %>
      <a href="/book" class="btn btn-primary header-quote-btn">Get a quote</a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-controls="main-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
