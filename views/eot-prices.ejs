<%# End of tenancy prices page (/end-of-tenancy-cleaning/prices/). Data: data/eot-prices.js. Styles: public/css/eot-prices.css.
    Simple layout (Silvia, 24 Nov 2026): calculator first, one price list, add ons, what's included, then questions.
    The calculator is a small inline script with no network requests; the price list is also plain HTML. %>
<link rel="stylesheet" href="/css/eot-prices.css?v=<%= assetVersion %>" />
<%
  const money = (n) => '£' + (Number.isInteger(n) ? n : n.toFixed(2));
  const book = bookUrl('end-of-tenancy-cleaning');
  const common = p.extras.filter(function (g) { return /Blinds|Outside/.test(g.group); });
  const more = p.extras.filter(function (g) { return !/Blinds|Outside/.test(g.group); });
  const questions = p.sizeAnswers.concat(p.faqs);
%>
<div class="ep">

<header class="ep-hero"><div class="ep-wrap">
  <h1>End of tenancy cleaning prices</h1>
  <p class="ep-lead">Your price is worked out from your home: flat or house, the number of bedrooms and bathrooms, and how furnished it is. The oven and extras like blinds are added only if your home has them, so you never pay for something you don't have. Prices are the same in London and Essex, with no VAT.</p>

  <form class="ep-calc" id="calculator" data-prices="<%= JSON.stringify({ flats: p.flats.map(f => [f.key, f.prices]), houses: p.houses.map(h => [h.key, h.prices]), bath: p.extraRooms[0].prices, ovens: p.ovens.map(o => [o.key, o.price]), extra: p.sameDaySunday }) %>">
    <div class="ep-steps">
      <fieldset class="ep-step"><legend>Your home</legend>
        <div class="ep-type">
          <label class="ep-big"><input type="radio" name="type" value="flat" checked><span><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="10" y="6" width="28" height="36" rx="2"/><path d="M16 13h4M28 13h4M16 21h4M28 21h4M16 29h4M28 29h4M21 42v-7h6v7"/></svg>Flat</span></label>
          <label class="ep-big"><input type="radio" name="type" value="house"><span><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 22 24 8l18 14"/><path d="M11 19v23h26V19"/><path d="M20 42V30h8v12"/></svg>House</span></label>
        </div>
      </fieldset>
      <fieldset class="ep-step"><legend>Bedrooms</legend><div class="ep-opts"><label class="ep-opt"><input type="radio" name="beds" value="0"><span>Studio</span></label><label class="ep-opt"><input type="radio" name="beds" value="1"><span>1</span></label><label class="ep-opt"><input type="radio" name="beds" value="2" checked><span>2</span></label><label class="ep-opt"><input type="radio" name="beds" value="3"><span>3</span></label><label class="ep-opt"><input type="radio" name="beds" value="4"><span>4</span></label><label class="ep-opt"><input type="radio" name="beds" value="5"><span>5</span></label><label class="ep-opt"><input type="radio" name="beds" value="6"><span>6</span></label></div></fieldset>
      <fieldset class="ep-step"><legend>Bathrooms</legend><div class="ep-opts"><label class="ep-opt"><input type="radio" name="baths" value="1" checked><span>1</span></label><label class="ep-opt"><input type="radio" name="baths" value="2"><span>2</span></label><label class="ep-opt"><input type="radio" name="baths" value="3"><span>3</span></label><label class="ep-opt"><input type="radio" name="baths" value="4"><span>4</span></label></div></fieldset>
      <fieldset class="ep-step"><legend>Furniture</legend><div class="ep-opts"><label class="ep-opt ep-opt--wide"><input type="radio" name="furn" value="0" checked><span>Unfurnished</span></label><label class="ep-opt ep-opt--wide"><input type="radio" name="furn" value="1"><span>Part furnished</span></label><label class="ep-opt ep-opt--wide"><input type="radio" name="furn" value="2"><span>Furnished</span></label></div></fieldset>
      <fieldset class="ep-step"><legend>Oven</legend><div class="ep-opts"><label class="ep-opt ep-opt--wide"><input type="radio" name="oven" value="none" checked><span>No oven</span></label><label class="ep-opt ep-opt--wide"><input type="radio" name="oven" value="single"><span>Single</span></label><label class="ep-opt ep-opt--wide"><input type="radio" name="oven" value="double"><span>Double</span></label><label class="ep-opt ep-opt--wide"><input type="radio" name="oven" value="convection"><span>Single and convection</span></label><label class="ep-opt ep-opt--wide"><input type="radio" name="oven" value="range"><span>Range</span></label><label class="ep-opt ep-opt--wide"><input type="radio" name="oven" value="aga"><span>AGA</span></label></div></fieldset>
      <label class="ep-switch"><input type="checkbox" name="rush"><span></span>Same day or Sunday clean</label>
    </div>
    <aside class="ep-price" aria-live="polite">
      <span class="ep-price-label">Your price</span>
      <output class="ep-total" id="ep-total" for="calculator">£229</output>
      <ul class="ep-lines" id="ep-lines"><li><span>2 bedroom flat, unfurnished</span><span>£229</span></li></ul>
      <a class="h-btn h-btn--light ep-book" href="<%= book %>">Book this clean</a>
      <p>Carpets, sofas and other extras can be added when you book.</p>
    </aside>
  </form>
</div></header>

<section class="ep-band ep-white" id="price-list"><div class="ep-wrap">
  <h2>Price list</h2>
  <p class="ep-note">One bathroom is included in every price. <a href="/files/sn-cleaning-services-end-of-tenancy-price-list.pdf" download>Download the price list (PDF)</a></p>
  <div class="ep-grid2">
    <% [['Flats', p.flats], ['Houses', p.houses]].forEach(function (t) { %>
    <table class="ep-table">
      <caption><%= t[0] %></caption>
      <thead><tr><th scope="col">Bedrooms</th><th scope="col">Unfurnished</th><th scope="col">Part furnished</th><th scope="col">Furnished</th></tr></thead>
      <tbody><% t[1].forEach(function (r) { %><tr><th scope="row"><%= r.beds === 0 ? 'Studio' : r.beds %></th><% r.prices.forEach(function (v) { %><td><%= money(v) %></td><% }); %></tr><% }); %></tbody>
    </table>
    <% }); %>
  </div>
</div></section>

<section class="ep-band ep-sand" id="extras"><div class="ep-wrap">
  <h2>Add ons</h2>
  <p class="ep-note">Only add what your home has. You choose these in the booking form.</p>
  <div class="ep-grid2">
    <table class="ep-table">
      <caption>Extra rooms</caption>
      <thead><tr><th scope="col">Room</th><th scope="col">Unfurnished</th><th scope="col">Part furnished</th><th scope="col">Furnished</th></tr></thead>
      <tbody><% p.extraRooms.forEach(function (r) { %><tr><th scope="row"><% var lab = r.label.replace(/^Extra /, ''); %><%= lab.charAt(0).toUpperCase() + lab.slice(1) %></th><% r.prices.forEach(function (v) { %><td><%= money(v) %></td><% }); %></tr><% }); %></tbody>
    </table>
    <table class="ep-table">
      <caption>Oven, blinds and more</caption>
      <tbody>
        <% p.ovens.filter(function (o) { return o.price; }).forEach(function (o) { %><tr><th scope="row"><%= o.label %></th><td><%= money(o.price) %></td></tr><% }); %>
        <% common.forEach(function (g) { g.items.forEach(function (i) { %><tr><th scope="row"><%= i.label %></th><td><%= money(i.price) %></td></tr><% }); }); %>
        <tr><th scope="row">Same day or Sunday clean</th><td><%= money(p.sameDaySunday) %></td></tr>
      </tbody>
    </table>
  </div>
  <details class="ep-more">
    <summary>Carpets, sofas, mattresses and waste removal</summary>
    <div class="ep-grid2">
      <% more.forEach(function (g) { %>
      <table class="ep-table">
        <caption><%= g.group.replace(', added to your end of tenancy clean', '') %></caption>
        <tbody><% g.items.forEach(function (i) { %><tr><th scope="row"><%= i.label %></th><td><%= money(i.price) %></td></tr><% }); %></tbody>
      </table>
      <% }); %>
    </div>
  </details>
</div></section>

<section class="ep-band ep-white"><div class="ep-wrap ep-grid2">
  <div>
    <h2>Included</h2>
    <ul class="ep-list">
      <li>Every room cleaned top to bottom, inside the home</li>
      <li>Inside all kitchen cupboards, drawers, fridge, freezer and microwave</li>
      <li>Bathrooms cleaned and descaled</li>
      <li>Inside windows and all internal glass</li>
      <li>Skirting boards, doors, switches and radiators</li>
      <li>Carpets vacuumed and floors washed</li>
      <li>All products and equipment</li>
      <li>Deposit back guarantee and a free re clean within 7 days</li>
    </ul>
  </div>
  <div>
    <h2>Not included</h2>
    <ul class="ep-list ep-list--no">
      <li>Outside windows</li>
      <li>Washing whole walls</li>
      <li>London Congestion Charge and parking, added on top where they apply</li>
    </ul>
  </div>
</div></section>

<section class="ep-band ep-sand"><div class="ep-wrap">
  <h2>Questions about prices</h2>
  <div class="h-faq">
    <% questions.forEach(function (f) { %>
      <details class="h-faq-item">
        <summary><h3><%= f.q %></h3><span class="h-faq-icon" aria-hidden="true"></span></summary>
        <p><%= f.a %><% if (f.source) { %> Source: <a href="<%= f.source.url %>" rel="noopener" target="_blank"><%= f.source.name %></a>.<% } %></p>
      </details>
    <% }); %>
  </div>
  <p class="ep-note ep-center">More on the <a href="/end-of-tenancy-cleaning/faq/">end of tenancy cleaning FAQ</a> and the <a href="/end-of-tenancy-cleaning/">end of tenancy cleaning</a> page.</p>
  <%- include('partials/author-box') %>
</div></section>

</div>

<script>
(function () {
  var f = document.getElementById('calculator'); if (!f) return;
  var d = JSON.parse(f.getAttribute('data-prices'));
  var names = ['unfurnished', 'part furnished', 'furnished'];
  function m(n) { return '£' + (Math.round(n * 100) % 100 ? n.toFixed(2) : Math.round(n)); }
  function find(list, key) { for (var i = 0; i < list.length; i++) if (list[i][0] === key) return list[i][1]; }
  function val(n) { var e = f.querySelector('input[name=' + n + ']:checked'); return e ? e.value : null; }
  function label(n) { var e = f.querySelector('input[name=' + n + ']:checked'); return e ? e.nextElementSibling.textContent.trim() : ''; }
  function calc() {
    var type = val('type');
    var studio = f.querySelector('input[name=beds][value="0"]');
    studio.disabled = type === 'house';
    if (type === 'house' && studio.checked) { f.querySelector('input[name=beds][value="1"]').checked = true; }
    var beds = +val('beds'), furn = +val('furn');
    var base = type === 'flat' ? find(d.flats, beds === 0 ? 'studio' : 'flat-' + beds) : find(d.houses, 'house-' + beds);
    var total = base[furn], rows = [[(beds === 0 ? 'Studio flat' : beds + ' bedroom ' + type) + ', ' + names[furn], base[furn]]];
    var extraBaths = +val('baths') - 1;
    if (extraBaths > 0) { var b = d.bath[furn] * extraBaths; total += b; rows.push([extraBaths + ' extra bathroom' + (extraBaths > 1 ? 's' : ''), b]); }
    var ov = find(d.ovens, val('oven')) || 0;
    if (ov) { total += ov; rows.push([label('oven') + ' oven', ov]); }
    if (f.rush.checked) { total += d.extra; rows.push(['Same day or Sunday', d.extra]); }
    document.getElementById('ep-total').textContent = m(total);
    document.getElementById('ep-lines').innerHTML = rows.map(function (r) { return '<li><span>' + r[0] + '</span><span>' + m(r[1]) + '</span></li>'; }).join('');
  }
  f.addEventListener('change', calc);
  f.addEventListener('submit', function (e) { e.preventDefault(); });
})();
</script>
