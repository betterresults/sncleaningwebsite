<%# End of tenancy prices page (/end-of-tenancy-cleaning/prices/). Data: data/eot-prices.js. Styles: public/css/eot-prices.css.
    Simple layout (Silvia, 24 Nov 2026): calculator first, one price list, add ons, what's included, then questions.
    The calculator is a small inline script with no network requests; the price list is also plain HTML. %>
<link rel="stylesheet" href="/css/eot-prices.css?v=<%= assetVersion %>" />
<%
  const money = (n) => '£' + (Number.isInteger(n) ? n : n.toFixed(2));
  const book = bookUrl('end-of-tenancy-cleaning');
  const common = p.extras.filter(function (g) { return /Blinds|Outside/.test(g.group); });
  const more = p.extras.filter(function (g) { return !/Blinds|Outside/.test(g.group); });
  const questions = p.sizeAnswers.concat(p.faqs);
%>
<div class="ep">

<header class="ep-hero"><div class="ep-wrap">
  <p class="ep-eyebrow">London and Essex · prices checked <%= p.checkedOn %></p>
  <h1>End of tenancy cleaning prices</h1>
  <p class="ep-lead">Choose your home to see the price. The prices are the same in London and Essex, and there is no VAT to add.</p>

  <form class="ep-calc" id="calculator" data-prices="<%= JSON.stringify({ flats: p.flats.map(f => [f.key, f.prices]), houses: p.houses.map(h => [h.key, h.prices]), bath: p.extraRooms[0].prices, ovens: p.ovens.map(o => [o.key, o.price]), extra: p.sameDaySunday }) %>">
    <fieldset><legend>Home</legend>
      <label><input type="radio" name="type" value="flat" checked> Flat</label>
      <label><input type="radio" name="type" value="house"> House</label>
    </fieldset>
    <label class="ep-field">Bedrooms
      <select name="beds"><option value="0">Studio</option><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></select>
    </label>
    <label class="ep-field">Bathrooms
      <select name="baths"><option value="1" selected>1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option></select>
    </label>
    <fieldset><legend>Furniture</legend>
      <label><input type="radio" name="furn" value="0" checked> None</label>
      <label><input type="radio" name="furn" value="1"> Some</label>
      <label><input type="radio" name="furn" value="2"> Furnished</label>
    </fieldset>
    <label class="ep-field">Oven
      <select name="oven"><% p.ovens.forEach(function (o) { %><option value="<%= o.key %>"<%= o.key === 'none' ? ' selected' : '' %>><%= o.label %></option><% }); %></select>
    </label>
    <label class="ep-check"><input type="checkbox" name="rush"> Same day or Sunday</label>
    <output class="ep-result" for="calculator" aria-live="polite">
      <span class="ep-total" id="ep-total">£229</span>
      <span class="ep-lines" id="ep-lines">2 bedroom flat, unfurnished</span>
    </output>
    <a class="h-btn h-btn--primary ep-book" href="<%= book %>">Book this clean</a>
  </form>
</div></header>

<section class="ep-band ep-white" id="price-list"><div class="ep-wrap">
  <h2>Price list</h2>
  <p class="ep-note">One bathroom is included in every price. <a href="/files/sn-cleaning-services-end-of-tenancy-price-list.pdf" download>Download the price list (PDF)</a></p>
  <div class="ep-grid2">
    <% [['Flats', p.flats], ['Houses', p.houses]].forEach(function (t) { %>
    <table class="ep-table">
      <caption><%= t[0] %></caption>
      <thead><tr><th scope="col">Bedrooms</th><th scope="col">Unfurnished</th><th scope="col">Part furnished</th><th scope="col">Furnished</th></tr></thead>
      <tbody><% t[1].forEach(function (r) { %><tr><th scope="row"><%= r.beds === 0 ? 'Studio' : r.beds %></th><% r.prices.forEach(function (v) { %><td><%= money(v) %></td><% }); %></tr><% }); %></tbody>
    </table>
    <% }); %>
  </div>
</div></section>

<section class="ep-band ep-sand" id="extras"><div class="ep-wrap">
  <h2>Add ons</h2>
  <p class="ep-note">Only add what your home has. You choose these in the booking form.</p>
  <div class="ep-grid2">
    <table class="ep-table">
      <caption>Extra rooms</caption>
      <thead><tr><th scope="col">Room</th><th scope="col">Unfurnished</th><th scope="col">Part furnished</th><th scope="col">Furnished</th></tr></thead>
      <tbody><% p.extraRooms.forEach(function (r) { %><tr><th scope="row"><% var lab = r.label.replace(/^Extra /, ''); %><%= lab.charAt(0).toUpperCase() + lab.slice(1) %></th><% r.prices.forEach(function (v) { %><td><%= money(v) %></td><% }); %></tr><% }); %></tbody>
    </table>
    <table class="ep-table">
      <caption>Oven, blinds and more</caption>
      <tbody>
        <% p.ovens.filter(function (o) { return o.price; }).forEach(function (o) { %><tr><th scope="row"><%= o.label %></th><td><%= money(o.price) %></td></tr><% }); %>
        <% common.forEach(function (g) { g.items.forEach(function (i) { %><tr><th scope="row"><%= i.label %></th><td><%= money(i.price) %></td></tr><% }); }); %>
        <tr><th scope="row">Same day or Sunday clean</th><td><%= money(p.sameDaySunday) %></td></tr>
      </tbody>
    </table>
  </div>
  <details class="ep-more">
    <summary>Carpets, sofas, mattresses and waste removal</summary>
    <div class="ep-grid2">
      <% more.forEach(function (g) { %>
      <table class="ep-table">
        <caption><%= g.group.replace(', added to your end of tenancy clean', '') %></caption>
        <tbody><% g.items.forEach(function (i) { %><tr><th scope="row"><%= i.label %></th><td><%= money(i.price) %></td></tr><% }); %></tbody>
      </table>
      <% }); %>
    </div>
  </details>
</div></section>

<section class="ep-band ep-white"><div class="ep-wrap ep-grid2">
  <div>
    <h2>Included</h2>
    <ul class="ep-list">
      <li>Every room cleaned top to bottom, inside the home</li>
      <li>Inside all kitchen cupboards, drawers, fridge, freezer and microwave</li>
      <li>Bathrooms cleaned and descaled</li>
      <li>Inside windows and all internal glass</li>
      <li>Skirting boards, doors, switches and radiators</li>
      <li>Carpets vacuumed and floors washed</li>
      <li>All products and equipment</li>
      <li>Deposit back guarantee and a free re clean within 7 days</li>
    </ul>
  </div>
  <div>
    <h2>Not included</h2>
    <ul class="ep-list ep-list--no">
      <li>Outside windows</li>
      <li>Washing whole walls</li>
      <li>London Congestion Charge and parking, added on top where they apply</li>
    </ul>
  </div>
</div></section>

<section class="ep-band ep-sand"><div class="ep-wrap">
  <h2>Questions about prices</h2>
  <div class="h-faq">
    <% questions.forEach(function (f) { %>
      <details class="h-faq-item">
        <summary><h3><%= f.q %></h3><span class="h-faq-icon" aria-hidden="true"></span></summary>
        <p><%= f.a %><% if (f.source) { %> Source: <a href="<%= f.source.url %>" rel="noopener" target="_blank"><%= f.source.name %></a>.<% } %></p>
      </details>
    <% }); %>
  </div>
  <p class="ep-note ep-center">More on the <a href="/end-of-tenancy-cleaning/faq/">end of tenancy cleaning FAQ</a> and the <a href="/end-of-tenancy-cleaning/">end of tenancy cleaning</a> page.</p>
  <%- include('partials/author-box') %>
</div></section>

</div>

<script>
(function () {
  var f = document.getElementById('calculator'); if (!f) return;
  var d = JSON.parse(f.getAttribute('data-prices'));
  var names = ['unfurnished', 'part furnished', 'furnished'];
  function m(n) { return '£' + (Math.round(n * 100) % 100 ? n.toFixed(2) : Math.round(n)); }
  function find(list, key) { for (var i = 0; i < list.length; i++) if (list[i][0] === key) return list[i][1]; }
  function calc() {
    var type = f.querySelector('input[name=type]:checked').value;
    var beds = +f.beds.value, studio = f.beds.options[0];
    studio.disabled = type === 'house';
    if (type === 'house' && beds === 0) { f.beds.value = '1'; beds = 1; }
    var furn = +f.querySelector('input[name=furn]:checked').value;
    var base = type === 'flat' ? find(d.flats, beds === 0 ? 'studio' : 'flat-' + beds) : find(d.houses, 'house-' + beds);
    var total = base[furn], parts = [(beds === 0 ? 'Studio flat' : beds + ' bedroom ' + type) + ', ' + names[furn]];
    var extraBaths = +f.baths.value - 1;
    if (extraBaths > 0) { total += d.bath[furn] * extraBaths; parts.push(extraBaths + ' extra bathroom' + (extraBaths > 1 ? 's' : '')); }
    var ov = find(d.ovens, f.oven.value) || 0;
    if (ov) { total += ov; parts.push(f.oven.options[f.oven.selectedIndex].text.toLowerCase()); }
    if (f.rush.checked) { total += d.extra; parts.push('same day or Sunday'); }
    document.getElementById('ep-total').textContent = m(total);
    document.getElementById('ep-lines').textContent = parts.join(', ');
  }
  f.addEventListener('change', calc);
  f.addEventListener('submit', function (e) { e.preventDefault(); });
})();
</script>
