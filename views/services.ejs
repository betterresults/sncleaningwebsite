<section class="page-hero page-hero--photo page-hero--services">
  <div class="container">
    <span class="eyebrow">Services</span>
    <h1>What we actually clean</h1>
    <p>Homes, tenancy handovers, guest changeovers, offices and the deep cleans in between — scoped to the property, not a franchise package.</p>
  </div>
</section>

<%- include('partials/cleaning-checklist') %>

<section class="section">
  <div class="container services-list">
    <% services.forEach(function(service, i) { %>
      <div class="service-detail <%= i % 2 === 1 ? 'reverse' : '' %>" id="<%= service.slug %>">
        <div class="service-detail-media">
          <img src="<%= serviceImage(service.slug) %>?v=<%= assetVersion %>" alt="<%= service.title %>" />
        </div>
        <div class="service-detail-text">
          <h2><%= service.title %></h2>
          <p><%= service.short_description %></p>
          <ul class="feature-list">
            <% (service.features || []).forEach(function(f) { %>
              <li><%= f %></li>
            <% }); %>
          </ul>
          <div class="service-detail-actions">
            <a href="<%= bookHref(service) %>" class="btn btn-primary">Get a quote</a>
            <% if (service.hasDetailPage) { %>
              <a href="/<%= service.slug %>" class="btn btn-outline">What's included</a>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<section class="section cta-band">
  <div class="container cta-band-inner">
    <div>
      <h2>Not sure what you need?</h2>
      <p>Tell us about the property and we'll recommend the right clean.</p>
    </div>
    <a href="/contact" class="btn btn-primary btn-lg">Talk to us</a>
  </div>
</section>
