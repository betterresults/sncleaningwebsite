<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= title %> | <%= site.name %></title>
  <meta name="description" content="<%= (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : site.name + ' — professional residential and commercial cleaning services.' %>" />
  <link rel="canonical" href="<%= canonicalUrl %>" />
  <% if (typeof noindex !== 'undefined' && noindex) { %>
    <meta name="robots" content="noindex, nofollow" />
  <% } %>

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png?v=<%= assetVersion %>" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png?v=<%= assetVersion %>" />
  <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png?v=<%= assetVersion %>" />

  <!-- Open Graph / Twitter -->
  <% const ogTitle = (typeof title !== 'undefined' ? title : site.name) + ' | ' + site.name; %>
  <% const ogDesc = (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : site.name + ' — professional residential and commercial cleaning services.'; %>
  <meta property="og:type" content="<%= typeof post !== 'undefined' ? 'article' : 'website' %>" />
  <meta property="og:site_name" content="<%= site.name %>" />
  <meta property="og:title" content="<%= ogTitle %>" />
  <meta property="og:description" content="<%= ogDesc %>" />
  <meta property="og:url" content="<%= canonicalUrl %>" />
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>" />
  <% } %>
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= ogTitle %>" />
  <meta name="twitter:description" content="<%= ogDesc %>" />
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta name="twitter:image" content="<%= ogImage %>" />
  <% } %>

  <!-- Booking forms (Dilvon) and their data: connect early so forms open fast -->
  <link rel="preconnect" href="https://dilvon.com" />
  <link rel="preconnect" href="https://pkvihxsdbrwhsbnsqikg.supabase.co" crossorigin />
  <!-- Instant page changes: booking pages are prepared as soon as a page with a
       booking link loads; every other internal page is prepared on hover/touch. -->
  <script type="speculationrules">
  {
    "prerender": [
      { "tag": "booking", "where": { "href_matches": "/book{/*}?" }, "eagerness": "immediate" },
      { "tag": "site", "where": { "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/book{/*}?" } },
          { "not": { "href_matches": "/contact/success{/*}?" } },
          { "not": { "selector_matches": "[target=_blank], [download]" } }
        ] }, "eagerness": "moderate" }
    ]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
  <% if ((typeof isHome !== 'undefined' && isHome) || (typeof designV2 !== 'undefined' && designV2)) { %>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css?v=<%= assetVersion %>" />
  <% } %>

  <!-- Structured data -->
  <% if (typeof structuredData !== 'undefined') { %>
    <% structuredData.filter(Boolean).forEach(function(block) { %>
      <script type="application/ld+json"><%- JSON.stringify(block) %></script>
    <% }); %>
  <% } %>
</head>
<% const isHomePage = (typeof isHome !== 'undefined' && isHome) || (typeof designV2 !== 'undefined' && designV2); /* pages on the new design system */ %>
<body class="<%= (isHomePage || currentPath === '/contact' || currentPath.indexOf('/contact/') === 0) ? 'no-sticky' : '' %><%= isHomePage ? ' is-home' : '' %>">
  <%- include('../partials/header') %>

  <main>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <% if (!isHomePage && currentPath !== '/contact' && currentPath.indexOf('/contact/') !== 0) { %>
  <div class="sticky-bar">
    <div class="container sticky-bar-inner">
      <span class="sticky-bar-label"><span class="pulse-dot"></span> Need a quote?</span>
      <form action="/book" method="GET" class="sticky-bar-form">
        <input type="text" name="postcode" placeholder="Postcode" aria-label="Postcode" autocomplete="postal-code" />
        <button type="submit" class="btn btn-primary">Quote</button>
      </form>
    </div>
  </div>
  <% } %>

  <% if (site.whatsappUrl) { %>
  <a href="<%= site.whatsappUrl %>" class="wa-float" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7c-2 0-4-.5-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.2c-.2.2-.4.3-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7c0 1.6 1.2 3.1 1.3 3.3.2.2 2.3 3.5 5.5 4.9 2 .9 2.8.9 3.8.8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.5Z"/></svg><span class="wa-float-text">Chat on WhatsApp</span>
  </a>
  <% } %>

  <script src="/js/main.js?v=<%= assetVersion %>"></script>
  <% if (isHomePage) { %><script src="/js/home.js?v=<%= assetVersion %>" defer></script><% } %>
</body>
</html>
