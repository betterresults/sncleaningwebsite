<section class="page-hero page-hero--plain">
  <div class="container">
    <span class="eyebrow">Blog</span>
    <h1>Cleaning tips &amp; news</h1>
    <p>Notes from the SN team in London and Essex: how we quote, what a move-out covers, and how often to book.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (!posts.length) { %>
      <p>No posts published yet — check back soon.</p>
    <% } else { %>
      <div class="grid grid-3">
        <% posts.forEach(function(post) { %>
          <a href="/blog/<%= post.slug %>" class="card service-card">
            <% if (post.cover_image) { %>
              <div class="service-card-photo">
                <img src="<%= post.cover_image %>?v=<%= assetVersion %>" alt="<%= post.title %>" />
              </div>
            <% } %>
            <div class="service-card-body">
              <% if (post.published_at) { %>
                <time class="blog-card-date" datetime="<%= post.published_at %>"><%= new Date(post.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></time>
              <% } %>
              <h3><%= post.title %></h3>
              <p><%= post.excerpt %></p>
              <span class="card-link">Read more →</span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
