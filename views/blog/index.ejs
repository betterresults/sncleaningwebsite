<section class="page-hero page-hero--plain">
  <div class="container">
    <span class="eyebrow">Blog</span>
    <h1>Cleaning tips &amp; news</h1>
    <p>Notes from the SN team in London and Essex: how we quote, what a move out covers, and how often to book.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <a href="/clean-home-report/" class="card service-card" style="margin-bottom:28px">
      <div class="service-card-body">
        <span class="eyebrow">Research</span>
        <h2 class="h3">The clean home report</h2>
        <p>Published research links cluttered, chaotic homes with higher stress, lower wellbeing, poorer sleep and more procrastination.</p>
        <span class="card-link">Read the report →</span>
      </div>
    </a>
    <!--sb:posts--><% if (!posts.length) { %>
      <p>No posts published yet, check back soon.</p>
    <% } else { %>
      <div class="grid grid-3">
        <% posts.forEach(function(post, i) { %>
          <a href="<%= postUrl(post) %>" class="card service-card">
            <% if (post.cover_image) { %>
              <div class="service-card-photo">
                <img src="<%= post.cover_image %>?v=<%= assetVersion %>"<%- rs(post.cover_image, '(max-width: 800px) 100vw, 400px') %> alt="<%= post.title %>"<%- i > 2 ? ' loading="lazy"' : '' %> decoding="async" width="1152" height="864" />
              </div>
            <% } %>
            <div class="service-card-body">
              <% if (post.published_at) { %>
                <time class="blog-card-date" datetime="<%= post.published_at %>"><%= new Date(post.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></time>
              <% } %>
              <h2 class="h3"><%= post.title %></h2>
              <p><%= post.excerpt %></p>
              <span class="card-link">Read more →</span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %><!--/sb-->
  </div>
</section>
