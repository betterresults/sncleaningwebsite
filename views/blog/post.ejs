<section class="page-hero page-hero--plain">
  <div class="container">
    <span class="eyebrow">Blog</span>
    <h1><%= post.title %></h1>
    <% if (post.published_at) { %>
      <p>
        <time datetime="<%= post.published_at %>"><%= new Date(post.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></time>
      </p>
    <% } %>
  </div>
</section>

<section class="section blog-post">
  <div class="container blog-post-inner">
    <% if (post.cover_image) { %>
      <img class="blog-post-cover" src="<%= post.cover_image %>?v=<%= assetVersion %>" alt="" />
    <% } %>
    <div class="blog-content">
      <%- post.content %>
    </div>
    <div class="blog-post-cta">
      <p>Need a clean in London or Essex? Send your postcode and we will quote you — usually the same weekday.</p>
      <div class="blog-post-cta-actions">
        <a href="/book" class="btn btn-primary">Request a quote</a>
        <a href="/blog" class="btn btn-outline">All posts</a>
      </div>
    </div>
  </div>
</section>
